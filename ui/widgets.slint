// Controls shared by more than one column.
//
// Chron1 and Chron2 each hand-rolled the same button on a `Rectangle` and a
// `TouchArea`, and the two copies had already drifted: the viewer's carried a
// callback and four accessibility attributes, the window's carried neither.
// This is the viewer's version, lifted out so the drift stops.
//
// Nothing from `std-widgets` is used for either of these. Those follow the
// Slint style rather than the `Palette` global, which would leave them the only
// things on screen that Chron5 could not theme.

import { Palette } from "palette.slint";
import { Strings } from "strings.slint";

/// A label above its value.
///
/// Lived in `details.slint` while column 3 was its only user. The About pane is
/// the second, and Chron5's rule is to lift a shared recipe on the second use
/// rather than the third — "the cheap moment", and the one Chron1's and Chron2's
/// two button copies went past before `Btn` existed.
export component DetailRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> wrap: false;

    spacing: 4px;

    Text {
        text: root.label;
        color: Palette.muted;
        font-size: 12px;
        letter-spacing: 1px;
    }

    Text {
        text: root.value;
        color: Palette.text;
        font-size: 14px;
        wrap: root.wrap ? word-wrap : no-wrap;
        overflow: root.wrap ? clip : elide;
    }
}

/// The product list's search bar (CORE §4).
///
/// Full column width and a fixed height, for the reason CORE §10 records for the
/// serial strip: it holds one line of text, and a bar that grew with the window
/// would be absurd on a tall one. A fixed *width* inside a column that is itself
/// a quarter of the window would sit in a widening pool of empty panel on any
/// large monitor, which is the other half of the same argument.
///
/// Not `Field`: that one is form-shaped, with a label above and an error line
/// below, and a search bar wants neither. What they share is the inner
/// `TextInput` and its configuration.
export component SearchBar inherits Rectangle {
    in-out property <string> text <=> input.text;
    /// Emitted on every keystroke. The caller is expected to make this cheap —
    /// `vault::plan_query` deliberately does not touch the viewer.
    callback edited(string);
    callback cleared();

    height: 40px;
    background: Palette.panel;

    Rectangle {
        x: 12px;
        y: (parent.height - 28px) / 2;
        width: parent.width - 24px;
        height: 28px;
        border-radius: 5px;
        border-width: 1px;
        border-color: input.has-focus ? Palette.accent : Palette.border;
        background: Palette.bg;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 4px;
            spacing: 4px;

            input := TextInput {
                color: Palette.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                horizontal-stretch: 1;
                accessible-label: Strings.search-placeholder;

                edited => {
                    root.edited(self.text);
                }

                key-pressed(event) => {
                    // Escape clears rather than closing anything, because there
                    // is nothing here to close. A filter the user cannot see the
                    // end of is the thing worth having a key for.
                    if (event.text == Key.Escape && self.text != "") {
                        self.text = "";
                        root.edited("");
                        root.cleared();
                        return accept;
                    }
                    reject
                }
            }

            // Occupies no width until there is something to clear, so the field
            // does not reflow as the first character is typed.
            if root.text != "": clear := Rectangle {
                width: 20px;

                Text {
                    text: Strings.remove-glyph;
                    color: clear-touch.has-hover ? Palette.accent : Palette.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }

                clear-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        input.text = "";
                        root.edited("");
                        root.cleared();
                    }
                }

                accessible-role: button;
                accessible-label: Strings.search-clear;
                accessible-action-default => {
                    input.text = "";
                    root.edited("");
                    root.cleared();
                }
            }
        }

        // Behind the text, the way `Field`'s hint is, so an empty bar shows what
        // it is for without spending a row on a label.
        if input.text == "": Text {
            x: 8px;
            text: Strings.search-placeholder;
            color: Palette.muted;
            font-size: 13px;
            vertical-alignment: center;
            height: parent.height;
        }
    }

    // Bottom hairline, matching the sort row above it.
    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Palette.border;
    }
}

/// A text button.
export component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    /// The affirmative one in a row of buttons.
    in property <bool> primary: false;
    callback clicked();

    height: 28px;
    border-radius: 5px;
    border-width: 1px;
    border-color: touch.pressed || (root.enabled && touch.has-hover)
        ? Palette.accent
        : (root.enabled && root.primary ? Palette.accent : Palette.border);
    background: touch.pressed
        ? Palette.selection
        : (root.enabled && touch.has-hover
            ? Palette.raised
            : (root.enabled && root.primary ? Palette.selection : Palette.panel));

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            color: root.enabled ? Palette.text : Palette.muted;
            vertical-alignment: center;
            font-size: 13px;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

/// A square glyph button — page navigation, and removing a row.
export component GlyphBtn inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 5px;
    border-width: 1px;
    border-color: touch.pressed || (root.enabled && touch.has-hover) ? Palette.accent : Palette.border;
    background: touch.pressed ? Palette.selection : (root.enabled && touch.has-hover ? Palette.raised : Palette.panel);

    // The glyph carries no meaning to a screen reader; callers supply the
    // label, which needs a role to attach to.
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }

    Text {
        text: root.glyph;
        color: root.enabled ? Palette.text : Palette.muted;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

/// A horizontal slider.
///
/// Hand-rolled for the reason at the top of this file, and Chron5 is where that
/// reason stopped being hypothetical. The zoom control was `std-widgets`' own
/// `Slider`, which draws itself from the Slint style rather than from `Palette` —
/// so it stayed the same blue-grey whatever theme was chosen, and on Catppuccin
/// Latte or Paperlike it was the one object on screen that had not changed. A
/// screenshot found it; no test would have, because no test looks at a colour it
/// did not push.
export component Slider inherits Rectangle {
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    in property <float> value: 0.0;
    /// The value under the pointer. Emitted continuously while dragging, so the
    /// caller is expected to debounce — `viewer.rs` already does.
    callback moved(float);

    height: 20px;
    min-width: 60px;

    property <length> knob: 14px;
    /// The distance the knob's own left edge travels, so it never overhangs.
    property <length> span: max(root.width - root.knob, 1px);
    property <float> range: max(root.maximum - root.minimum, 0.000001);
    property <float> fraction: clamp((root.value - root.minimum) / root.range, 0.0, 1.0);

    accessible-role: slider;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;

    // The track, and the part of it behind the knob.
    Rectangle {
        x: root.knob / 2;
        y: (parent.height - 4px) / 2;
        width: root.span;
        height: 4px;
        border-radius: 2px;
        background: Palette.border;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.fraction;
            height: parent.height;
            border-radius: 2px;
            background: Palette.accent;
        }
    }

    Rectangle {
        x: root.span * root.fraction;
        y: (parent.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: Palette.accent;
        // Against the panel, so the knob reads as sitting on the track rather
        // than merging with the filled part of it.
        border-width: 2px;
        border-color: Palette.panel;
    }

    // Reports where the pointer is, not where the knob was: clicking anywhere on
    // the track jumps to that value, which is what every slider does.
    function report(at: length) {
        root.moved(root.minimum + clamp((at - root.knob / 2) / root.span, 0.0, 1.0) * root.range);
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;

        moved => {
            if (self.pressed) {
                root.report(self.mouse-x);
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.report(self.mouse-x);
            }
        }
    }
}

/// A labelled single-line text field, with room for a message under it.
///
/// `error` is empty when the field is fine, and arrives pre-formatted from
/// Rust — the component holds no text of its own.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in-out property <string> text <=> input.text;
    in property <string> error;
    in property <bool> enabled: true;

    callback edited();
    callback accepted();

    spacing: 4px;

    Text {
        text: root.label;
        color: Palette.muted;
        font-size: 12px;
        letter-spacing: 1px;
    }

    Rectangle {
        height: 30px;
        border-radius: 5px;
        border-width: 1px;
        // A field that has something wrong with it says so in its outline as
        // well as in words, so the eye finds it before the sentence does.
        border-color: root.error != ""
            ? Palette.danger
            : input.has-focus ? Palette.accent : Palette.border;
        background: Palette.bg;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;

            input := TextInput {
                color: root.enabled ? Palette.text : Palette.muted;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                read-only: !root.enabled;
                accessible-label: root.label;

                edited => {
                    root.edited();
                }
                accepted => {
                    root.accepted();
                }
            }
        }

        // The hint sits behind the text rather than beside the label, so an
        // empty date field shows the shape it wants without spending a row.
        if input.text == "" && root.hint != "": Text {
            x: 8px;
            text: root.hint;
            color: Palette.muted;
            font-size: 13px;
            vertical-alignment: center;
            height: parent.height;
        }
    }

    if root.error != "": Text {
        text: root.error;
        color: Palette.danger;
        font-size: 12px;
        wrap: word-wrap;
    }
}
