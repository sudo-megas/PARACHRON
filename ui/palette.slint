// The one hardcoded palette Chron1 allowed, lifted out of `app.slint` in
// Chron2 so the viewer can share it without importing the window.
//
// Chron5 replaces this with the eleven themes from CORE §5, switchable at
// runtime — keeping every colour behind this global is what makes that a
// contained change.

export global Palette {
    out property <color> bg: #1b1b1d;
    out property <color> panel: #232326;
    out property <color> raised: #2c2c31;
    out property <color> border: #3a3a40;
    out property <color> text: #e6e6e8;
    out property <color> muted: #9a9aa2;
    out property <color> accent: #6fb2d2;
    out property <color> danger: #e0736d;
    out property <color> selection: #34343b;

    // The sheet a page is drawn on, and the shadow that separates it from the
    // panel behind. A white page against a dark pane needs an edge or it
    // reads as a hole.
    out property <color> paper: #ffffff;
    out property <color> paper-edge: #101012;
}
