// The colour table (CORE §5).
//
// Chron1 put every colour behind this global and Chron2 lifted it into its own
// file, both so that theming would be a contained change. Chron5 is where that
// is collected on: the properties are `in` rather than `out` and `src/theme.rs`
// fills them, exactly the way `src/strings.rs` fills the `Strings` global.
//
// The initializers are kept, and they are Default Dark — `config.toml`'s own
// default. Without them the window paints one frame in whatever an unset colour
// means before Rust's push lands, which is a visible flash on every start; with
// them the pre-push frame and the post-push frame are identical for the common
// case, so the flash is absent rather than merely hidden. They also keep
// `ui_tests.rs` honest, which builds a window and calls `apply_strings` and
// nothing else.
//
// Five of these are surfaces, and they are a ladder rather than five unrelated
// colours — `bg`, `panel`, `raised`, `selection`, `border`, in order of distance
// from the canvas. A new theme is built by walking a source palette's surface
// tokens in that order.

export global Palette {
    // The canvas: the window behind everything, and the pane a page sits in.
    in property <color> bg: #1b1b1d;
    // Panels that sit above the canvas — the title bar, and now every
    // column's masthead band (the sort row and search bar in column 1, the
    // tab strip in column 2, the action row in column 3). Lighter than `bg`
    // in every theme, light ones included: a masthead reads as raised
    // because it's a step up this ladder from the canvas its column's body
    // sits on, not because a border says so.
    in property <color> panel: #232326;
    // Hovered. One step further from the panel than at rest, which on a dark
    // theme means lighter and on a light theme means darker — "more contrast",
    // not "brighter". Reading the role literally is what makes hand-converted
    // light themes look washed out.
    in property <color> raised: #2c2c31;
    // Hairlines.
    in property <color> border: #3a3a40;
    in property <color> text: #e6e6e8;
    // Labels and secondary lines. Deliberately quiet, so it is held to the
    // large-text contrast floor rather than the body-text one (see theme.rs).
    in property <color> muted: #9a9aa2;
    in property <color> accent: #6fb2d2;
    // The second and third hues, and the reason a theme reads as a palette
    // rather than as one colour.
    //
    // Every source palette here has more than one hue in it — Catppuccin
    // publishes fourteen accents per flavour, Rosé Pine six, Noctalia five,
    // Canonical a whole brand sheet. Until these two existed the table took
    // exactly one of them and spent the rest of its budget on five greys, so
    // eleven themes arrived on screen as eleven shades of a single colour and
    // the app looked the same in all of them. `accent` still carries the
    // interactive states — focus, selection, the active chip. These two carry
    // *identity*: column 1 is `accent`, column 2 is `accent2`, column 3 is
    // `accent3`, each column wearing its own hue at the top of its card and
    // tinted into its masthead, so the three sections read as three places.
    //
    // They are held to the 3:1 non-text floor against `panel` and `bg` — the
    // two surfaces a column rule ever touches — and not against `selection`,
    // which they are never drawn on. See theme.rs for where each theme's two
    // extra hues come from, and which ones had to move to clear the floor.
    in property <color> accent2: #d8a76b;
    in property <color> accent3: #a892e0;
    // Broken folders, expired warranties, refused files. Red in ten of the
    // eleven themes; see theme.rs for the one where it cannot be.
    in property <color> danger: #e0736d;
    // The selected row, and an active chip.
    in property <color> selection: #34343b;

    // The sheet a page is drawn on, and the shadow that separates it from the
    // panel behind. A white page against a dark pane needs an edge or it
    // reads as a hole.
    //
    // `paper` is white in every theme and is not a design choice to revisit:
    // `render.rs` rasterizes with `alpha: false`, so a page arrives already
    // opaque and white-backed and the `Image` covers this rectangle exactly.
    // A themed `paper` would be invisible except for the instant before the
    // first page lands, where it would flash a colour the page is not. Only
    // `paper-edge` varies — and on a light theme it has to get lighter, or it
    // reads as a black frame.
    in property <color> paper: #ffffff;
    in property <color> paper-edge: #101012;

    // The dim behind a sheet. Carries its own alpha.
    //
    // This was a literal in `form.slint` until Chron5 — the one colour in `ui/`
    // that was not here, and exactly the one that would have made "switch the
    // theme and the window follows" quietly false: a sheet over a light theme
    // would have dimmed it with the 55% black that suits a dark one.
    in property <color> backdrop: #0000008c;
}
