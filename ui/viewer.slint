// Column 2 — the document viewer (CORE §4).
//
// Tabs across the top in `pdfs` order, one page fitted into the pane below,
// a control row carrying prev/next, the page counter and the zoom slider, and
// a fixed serial-number strip pinned at the bottom.
//
// This component holds no text of its own: every string arrives through the
// `Strings` global or as a property filled from Rust.

import { Palette } from "palette.slint";
import { Strings } from "strings.slint";
import { Slider } from "widgets.slint";

/// One tab. `missing` marks a file named in `product.toml` that is not on disk.
export struct DocTab {
    label: string,
    missing: bool,
}

/// Square glyph button used for page navigation.
component NavButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> active: true;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 5px;
    border-width: 1px;
    border-color: touch.pressed || (root.active && touch.has-hover) ? Palette.accent : Palette.border;
    background: touch.pressed ? Palette.selection : (root.active && touch.has-hover ? Palette.raised : Palette.panel);

    // The glyph carries no meaning to a screen reader; callers supply the
    // label, which needs a role to attach to.
    accessible-role: button;
    accessible-enabled: root.active;
    accessible-action-default => {
        root.clicked();
    }

    Text {
        text: root.glyph;
        color: root.active ? Palette.text : Palette.muted;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

export component Viewer inherits Rectangle {
    // Tabs and selection
    in property <[DocTab]> tabs;
    in-out property <int> active-tab: 0;

    // The rendered page. `page-width`/`page-height` are the logical size Rust
    // wants it drawn at — the raster is already sized for this display, so
    // drawing it at anything else would resample a perfectly good image.
    in property <image> page;
    in property <length> page-width;
    in property <length> page-height;

    // Page position. `page-label` arrives pre-formatted so the "2 / 12"
    // punctuation stays on the Rust side with the rest of the formatting.
    in property <int> page-index;
    in property <int> page-count;
    in property <string> page-label;

    in property <bool> busy;
    // Non-empty means show this instead of a page.
    in property <string> error-text;

    in property <string> serial;
    in property <bool> serial-copied;

    in-out property <float> zoom: 1.0;

    callback tab-selected(int);
    callback page-requested(int);
    callback zoom-changed(float);
    callback copy-serial();
    callback viewport-resized(length, length);

    background: Palette.bg;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        // ── Tab row ──────────────────────────────────────────────────────
        Rectangle {
            height: 40px;
            background: Palette.panel;

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Palette.border;
            }

            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: max(tab-row.preferred-width, self.width);
                viewport-height: self.height;

                tab-row := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 4px;
                    alignment: start;

                    for tab[index] in root.tabs: Rectangle {
                        y: 6px;
                        height: 28px;
                        width: label.preferred-width + 24px;
                        border-radius: 5px;
                        background: index == root.active-tab
                            ? Palette.raised
                            : (tab-touch.has-hover ? Palette.selection : transparent);
                        border-width: 1px;
                        border-color: index == root.active-tab ? Palette.border : transparent;

                        label := Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text: tab.label;
                            color: tab.missing
                                ? Palette.danger
                                : (index == root.active-tab ? Palette.text : Palette.muted);
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        tab-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.tab-selected(index);
                            }
                        }
                    }
                }
            }
        }

        // ── Preview ──────────────────────────────────────────────────────
        preview := Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: Palette.bg;

            changed width => {
                root.viewport-resized(self.width, self.height);
            }
            changed height => {
                root.viewport-resized(self.width, self.height);
            }

            // Nothing to show: no documents, or a document that will not open.
            if root.tabs.length == 0 || root.error-text != "": Text {
                x: 24px;
                y: 24px;
                width: parent.width - 48px;
                text: root.tabs.length == 0 ? Strings.no-documents : root.error-text;
                color: root.tabs.length == 0 ? Palette.muted : Palette.danger;
                font-size: 14px;
                wrap: word-wrap;
            }

            if root.tabs.length > 0 && root.error-text == "": Flickable {
                width: parent.width;
                height: parent.height;
                // The page *plus its edge*, which is the whole reason for the
                // `+ 2px`. A `Flickable` clips hard to its own bounds and its
                // viewport does not grow to contain a child that sticks out, so a
                // viewport sized to the page alone cuts the edge off on whichever
                // axis the page fills — and at 1× zoom the fitted page fills one
                // axis exactly, by definition. A portrait invoice in a wide column
                // therefore lost its top and bottom line, and above 1× zoom, where
                // the page exceeds the pane on both axes, it lost all four.
                //
                // Panning does not rescue it: at scroll 0 the top line sits at −1,
                // and scrolled fully down the bottom line sits at exactly the
                // viewport's height. Both are outside the clip either way.
                viewport-width: max(root.page-width + 2px, self.width);
                viewport-height: max(root.page-height + 2px, self.height);

                // The page's edge, so a white page does not read as a hole
                // punched in the panel.
                //
                // Drawn as a rectangle one pixel *outside* the page rather than
                // as that rectangle's `border-width`, which is how Chron2 wrote
                // it and which never appeared: a `border` is inset within the
                // rectangle's own bounds, and the `Image` below is positioned at
                // its origin at the full page size, so it painted straight over
                // the border every time a page was loaded. Chron5 found this by
                // asserting the colour was distinguishable from the pane, and a
                // palette role that is never drawn is Chron5's business.
                //
                // Putting the edge outside also keeps Chron2's other rule: the
                // image stays at exactly the pixels it was rasterized for, so
                // nothing is resampled. Insetting the image by a pixel instead
                // would have traded one defect for the other.
                Rectangle {
                    x: (parent.viewport-width - root.page-width) / 2 - 1px;
                    y: (parent.viewport-height - root.page-height) / 2 - 1px;
                    width: root.page-width + 2px;
                    height: root.page-height + 2px;
                    background: Palette.paper-edge;
                }

                Rectangle {
                    x: (parent.viewport-width - root.page-width) / 2;
                    y: (parent.viewport-height - root.page-height) / 2;
                    width: root.page-width;
                    height: root.page-height;
                    background: Palette.paper;

                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.page;
                        // Sized to the raster's own pixels, so no resampling.
                        image-fit: fill;
                    }
                }
            }

            // Shown while the first render of a document is in flight.
            if root.busy: Text {
                x: 24px;
                y: parent.height - 40px;
                text: Strings.rendering;
                color: Palette.muted;
                font-size: 13px;
            }
        }

        // ── Control row ──────────────────────────────────────────────────
        Rectangle {
            height: 40px;
            background: Palette.panel;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.border;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                prev := NavButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Strings.prev-glyph;
                    active: root.page-index > 0;
                    accessible-label: Strings.prev-page;
                    clicked => {
                        root.page-requested(root.page-index - 1);
                    }
                }

                next := NavButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Strings.next-glyph;
                    active: root.page-index + 1 < root.page-count;
                    accessible-label: Strings.next-page;
                    clicked => {
                        root.page-requested(root.page-index + 1);
                    }
                }

                Text {
                    text: root.page-label;
                    color: Palette.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: Strings.zoom-label;
                    color: Palette.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                zoom-slider := Slider {
                    y: (parent.height - self.height) / 2;
                    width: 140px;
                    minimum: 1.0;
                    maximum: 4.0;
                    value: root.zoom;
                    accessible-label: Strings.zoom-label;
                    moved(v) => {
                        root.zoom-changed(v);
                    }
                }
            }
        }

        // ── Serial strip (CORE §4; height pinned here, see CORE §10) ──────
        Rectangle {
            height: 44px;
            background: Palette.panel;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.border;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                Text {
                    text: Strings.serial-label;
                    color: Palette.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.serial;
                    color: Palette.text;
                    font-size: 14px;
                    font-family: "monospace";
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // Confirmation, in the same spot the copy affordance lives.
                Text {
                    text: root.serial-copied ? Strings.copied : Strings.copy-glyph;
                    color: root.serial-copied ? Palette.accent : Palette.muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            serial-touch := TouchArea {
                enabled: root.serial != "";
                mouse-cursor: root.serial != "" ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    root.copy-serial();
                }
            }
        }
    }
}
