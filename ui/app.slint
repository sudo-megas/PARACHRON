// Parachron — main window (CORE §4).
//
// Three fixed columns at 25 / 50 / 25, minimum 1000×700. This milestone builds
// the skeleton only: the list is live, the viewer and details panes are
// placeholders that later Chrons fill in.

import { ListView } from "std-widgets.slint";
import { Palette } from "palette.slint";
import { Strings } from "strings.slint";
import { Viewer, DocTab } from "viewer.slint";
import { FormSheet, FormDoc } from "form.slint";
import { ThemeSheet, ThemeItem } from "theme.slint";
import { Details } from "details.slint";
import { Btn } from "widgets.slint";

// Re-exported so Rust can reach the globals and the structs.
//
// `Palette` is here as of Chron5 and this is not cosmetic: `include_modules!`
// generates Rust bindings for exported globals only, so `app.global::<Palette>()`
// does not compile until the name is in this list. The whole of `theme.rs`
// depends on that one word.
export { Strings, Palette, DocTab, FormDoc, ThemeItem }

// One row of the product list. Assembled in Rust so that every string it
// carries — including the broken/warning prefixes — comes from the string table.
export struct ProductItem {
    label: string,
    name: string,
    detail: string,
    // The manifest could not be parsed at all.
    broken: bool,
    // The manifest parsed, but files it lists are not on disk.
    warning: bool,
}

// One of column 1's two sort toggles.
component SortChip inherits Rectangle {
    in property <string> label;
    /// What it does, for a screen reader — the chip itself is two letters.
    in property <string> description;
    in property <bool> active;
    callback clicked();

    height: 22px;
    width: chip-label.preferred-width + 18px;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.active ? Palette.accent : Palette.border;
    background: root.active ? Palette.selection : transparent;

    accessible-role: button;
    accessible-label: root.description;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => {
        root.clicked();
    }

    chip-label := Text {
        text: root.label;
        color: root.active ? Palette.text : Palette.muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One entry in the `Document ▾` menu.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    border-radius: 4px;
    background: root.enabled && touch.has-hover ? Palette.raised : transparent;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.label;
            color: root.enabled ? Palette.text : Palette.muted;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    // Filled from Rust at startup.
    in property <[ProductItem]> products;

    // Selection state. -1 means nothing is selected yet.
    in-out property <int> selected-index: -1;
    in-out property <string> selected-name;
    in-out property <string> selected-detail;
    in-out property <bool> selected-broken;

    // Viewer state, driven from Rust (Chron2).
    in property <[DocTab]> doc-tabs;
    in-out property <int> active-tab: 0;
    in property <image> page;
    in property <length> page-width;
    in property <length> page-height;
    in property <int> page-index;
    in property <int> page-count;
    in property <string> page-label;
    in property <bool> viewer-busy;
    in property <string> viewer-error;
    in property <string> selected-serial;
    in property <bool> serial-copied;
    in-out property <float> zoom: 1.0;

    // One product row. Shared so the scroll arithmetic below and the rows
    // themselves cannot drift apart.
    property <length> row-height: 38px;

    // Bring a row into view after the list has been rebuilt.
    //
    // Imperative, never a `viewport-y:` binding: the repeater *assigns*
    // `viewport-y` while laying out (including a zeroing pass when the model is
    // empty, which every window hits before Rust has filled it), and assigning
    // to a property removes its binding for good.
    //
    // Top-aligning rather than scrolling the minimum distance is also
    // deliberate. A jump of more than one and a half screens is snapped to a
    // whole row, and `idx * row-height` already sits on one — so this lands
    // exactly where it says it will, first time. A bottom-aligned target does
    // not, and would need calling twice.
    //
    // A negative index clamps to the top, which is also what a list that just
    // got shorter needs: the runtime does not clamp `viewport-y` against the
    // new, smaller `viewport-height`, and a stale offset leaves the list
    // showing its last row alone above a band of empty space.
    public function scroll-row-into-view(idx: int) {
        let limit = max(0px, list.viewport-height - list.visible-height);
        // Clamping what is already there is what rescues a list that just got
        // shorter: the runtime does not clamp `viewport-y` against the new,
        // smaller `viewport-height`, and a stale offset leaves the list showing
        // its last row alone above a band of empty space.
        let seen = clamp(-list.viewport-y, 0px, limit);

        if (idx < 0) {
            list.viewport-y = -seen;
            return;
        }

        let top = idx * root.row-height;
        let bottom = top + root.row-height;

        // Already in view: leave the list exactly where the user left it.
        // Scrolling on every click would drag the clicked row to the top and
        // throw away the scroll position they had chosen.
        if (top >= seen && bottom <= seen + list.visible-height) {
            list.viewport-y = -seen;
            return;
        }

        // Bringing a row down from above, or a jump far enough that the runtime
        // would snap a bottom-aligned target to a whole row and leave the row
        // half shown, is done by top-aligning — `idx * row-height` already sits
        // on a row boundary, so it lands exactly. Anything closer scrolls the
        // shortest distance instead.
        let far = top > seen + 2 * list.visible-height;
        let target = (top < seen || far) ? top : bottom - list.visible-height;
        list.viewport-y = -clamp(target, 0px, limit);
    }

    // ── Add and edit (Chron3) ────────────────────────────────────────────
    //
    // The sheet's text fields are `in-out`: the user types into them and Rust
    // reads them back when Save is pressed. Everything else is pushed from
    // Rust, already composed — the `.slint` side works out no messages of its
    // own.
    in property <bool> form-open;
    in property <string> form-heading;
    in-out property <string> form-name;
    in-out property <string> form-serial;
    in-out property <string> form-link;
    in-out property <string> form-purchase-date;
    in-out property <string> form-warranty-start;
    in-out property <string> form-warranty-end;
    in property <string> form-name-error;
    in property <string> form-purchase-date-error;
    in property <string> form-warranty-start-error;
    in property <string> form-warranty-end-error;
    in property <string> form-notice;
    in property <[FormDoc]> form-docs;
    in property <bool> form-busy;

    // ── Details column (Chron4) ──────────────────────────────────────────
    in property <bool> details-filled;
    in property <string> details-link;
    in property <string> details-purchase-date;
    in property <string> details-warranty-start;
    in property <string> details-warranty-end;
    /// Already formatted, expired case included — the string table holds no
    /// interpolation, so Rust composes it.
    in property <string> details-days-left;
    in property <bool> details-expired;
    in property <bool> link-copied;

    /// 0 as added, 1 alphabetical, 2 purchase date. CORE §4 describes two
    /// toggles over a default, which is what this is: clicking the active chip
    /// clears it back to 0.
    in property <int> sort-mode;

    // ── Theming (Chron5) ─────────────────────────────────────────────────
    //
    // The rows carry their own labels and their own active flag, both filled by
    // `theme.rs`, so nothing on this side knows how many themes there are.
    in property <[ThemeItem]> theme-rows;

    // Menu state is nobody's business but this file's, and so is whether the
    // theme picker is up: opening it is a UI gesture, and the only thing Rust
    // needs to hear about is a row being chosen.
    property <bool> menu-open: false;
    property <bool> theme-open: false;

    callback theme-selected(int);
    callback product-selected(int);
    callback tab-selected(int);
    callback page-requested(int);
    callback zoom-changed(float);
    callback copy-serial();
    callback copy-link();
    callback sort-toggled(int);
    callback viewport-resized(length, length);

    callback add-document();
    callback edit-document();
    callback form-add-pdf();
    callback form-remove-pdf(int);
    callback form-save();
    callback form-cancel();
    callback form-edited();
    /// Rung from the commit thread once a save has landed. It carries nothing:
    /// the outcome waits in a slot the editor reads, because the editor cannot
    /// cross a thread boundary.
    callback form-commit-finished();

    title: Strings.app-title;
    icon: @image-url("../build/icons/parachron-256.png");
    background: Palette.bg;

    // CORE §4: the window never shrinks below this.
    min-width: 1000px;
    min-height: 700px;
    preferred-width: 1280px;
    preferred-height: 800px;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        // ── Title bar ────────────────────────────────────────────────────
        Rectangle {
            height: 48px;
            background: Palette.panel;

            // Bottom hairline.
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Palette.border;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                Image {
                    source: @image-url("../build/icons/parachron-64.png");
                    width: 26px;
                    height: 26px;
                    image-fit: contain;
                    y: (parent.height - self.height) / 2;
                }

                menu-button := Btn {
                    label: Strings.menu-document;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.menu-open = !root.menu-open;
                    }
                }

                add-button := Btn {
                    label: Strings.action-add-document;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.menu-open = false;
                        root.add-document();
                    }
                }

                // Pushes the wordmark to the centre of the remaining space.
                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: Strings.app-title;
                    color: Palette.text;
                    font-size: 16px;
                    font-weight: 700;
                    letter-spacing: 3px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ── Body: three fixed columns, 25 / 50 / 25 ──────────────────────
        //
        // Positioned explicitly rather than by layout stretch so the ratio is
        // exact at every window size (CORE §4). Column 3 takes the remainder,
        // so rounding can never leave a seam.
        body := Rectangle {
            vertical-stretch: 1;

            // Column 1 — product list.
            col1 := Rectangle {
                x: 0;
                y: 0;
                width: body.width / 4;
                height: body.height;
                background: Palette.panel;
                clip: true;

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;

                    // ── Sort toggles (CORE §4) ───────────────────────────
                    //
                    // Two chips over a default of insertion order, which is
                    // literally what CORE §4 asks for: clicking the active one
                    // again clears it rather than needing a third chip.
                    Rectangle {
                        height: 34px;
                        background: Palette.panel;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;

                            sort-name := SortChip {
                                y: (parent.height - self.height) / 2;
                                label: Strings.sort-name;
                                description: Strings.sort-by-name;
                                active: root.sort-mode == 1;
                                clicked => {
                                    root.sort-toggled(root.sort-mode == 1 ? 0 : 1);
                                }
                            }

                            sort-purchase := SortChip {
                                y: (parent.height - self.height) / 2;
                                label: Strings.sort-purchase;
                                description: Strings.sort-by-purchase;
                                active: root.sort-mode == 2;
                                clicked => {
                                    root.sort-toggled(root.sort-mode == 2 ? 0 : 2);
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }
                        }

                        // Bottom hairline.
                        Rectangle {
                            x: 0;
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Palette.border;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;

                        list := ListView {
                            width: parent.width;
                            height: parent.height;

                            for item[idx] in root.products: Rectangle {
                                height: root.row-height;
                                background: idx == root.selected-index ? Palette.selection : transparent;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: item.label;
                                        color: item.broken
                                            ? Palette.danger
                                            : item.warning ? Palette.accent : Palette.text;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                row-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.selected-index = idx;
                                        root.selected-name = item.name;
                                        root.selected-detail = item.detail;
                                        root.selected-broken = item.broken;
                                        root.product-selected(idx);
                                    }
                                }
                            }
                        }

                        if root.products.length == 0: Text {
                            x: 14px;
                            y: 18px;
                            width: parent.width - 28px;
                            text: Strings.list-empty;
                            color: Palette.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    // Fixed About strip (CORE §4). Inert until Chron8.
                    Rectangle {
                        height: 42px;
                        background: Palette.panel;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: 1px;
                            background: Palette.border;
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: Strings.nav-about;
                                color: Palette.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Column 2 — document viewer (Chron2).
            col2 := Rectangle {
                x: col1.width;
                y: 0;
                width: body.width / 2;
                height: body.height;
                background: Palette.bg;
                clip: true;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Palette.border;
                }

                // Nothing selected, or a folder that would not parse — the
                // viewer has nothing to open, so Chron1's reason display stays.
                if root.selected-index < 0 || root.selected-broken: VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: root.selected-index >= 0 ? root.selected-name : Strings.select-prompt;
                        color: root.selected-broken ? Palette.danger : Palette.text;
                        font-size: 20px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.selected-detail;
                        color: Palette.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                if root.selected-index >= 0 && !root.selected-broken: viewer := Viewer {
                    x: 1px;
                    width: parent.width - 1px;
                    height: parent.height;

                    tabs: root.doc-tabs;
                    active-tab: root.active-tab;
                    page: root.page;
                    page-width: root.page-width;
                    page-height: root.page-height;
                    page-index: root.page-index;
                    page-count: root.page-count;
                    page-label: root.page-label;
                    busy: root.viewer-busy;
                    error-text: root.viewer-error;
                    serial: root.selected-serial;
                    serial-copied: root.serial-copied;
                    zoom: root.zoom;

                    tab-selected(index) => {
                        root.tab-selected(index);
                    }
                    page-requested(page) => {
                        root.page-requested(page);
                    }
                    zoom-changed(value) => {
                        root.zoom-changed(value);
                    }
                    copy-serial => {
                        root.copy-serial();
                    }
                    viewport-resized(w, h) => {
                        root.viewport-resized(w, h);
                    }
                }
            }

            // Column 3 — details and actions (Chron4). Takes the remainder so
            // the three widths always sum to exactly the window width.
            col3 := Rectangle {
                x: col1.width + col2.width;
                y: 0;
                width: body.width - col1.width - col2.width;
                height: body.height;
                background: Palette.panel;
                clip: true;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Palette.border;
                }

                details := Details {
                    x: 1px;
                    width: parent.width - 1px;
                    height: parent.height;

                    filled: root.details-filled;
                    link: root.details-link;
                    purchase-date: root.details-purchase-date;
                    warranty-start: root.details-warranty-start;
                    warranty-end: root.details-warranty-end;
                    days-left: root.details-days-left;
                    expired: root.details-expired;
                    link-copied: root.link-copied;

                    copy-link => {
                        root.copy-link();
                    }
                    open-theme => {
                        root.menu-open = false;
                        root.theme-open = true;
                    }
                }
            }
        }
    }

    // ── Document ▾ menu ──────────────────────────────────────────────────
    //
    // Hand-rolled rather than a `PopupWindow`. Elements inside a popup are not
    // reliably realised for the testing backend's element lookup, which would
    // put the whole menu — and the only route to the edit form — outside the
    // headless tests. This is a comparable amount of code and stays reachable.
    //
    // Declared after the layout so it draws over it, with a transparent layer
    // behind it to catch the dismissing click.
    if root.menu-open: Rectangle {
        dismiss-menu := TouchArea {
            clicked => {
                root.menu-open = false;
            }
        }

        Rectangle {
            x: 14px;
            y: 44px;
            width: 190px;
            height: menu-items.preferred-height;
            background: Palette.panel;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.border;

            menu-items := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                menu-add := MenuRow {
                    label: Strings.action-add-document;
                    clicked => {
                        root.menu-open = false;
                        root.add-document();
                    }
                }

                menu-edit := MenuRow {
                    label: Strings.action-edit-document;
                    // A folder whose manifest will not parse is repaired in a
                    // text editor, not guessed at by a form.
                    enabled: root.selected-index >= 0 && !root.selected-broken;
                    clicked => {
                        root.menu-open = false;
                        root.edit-document();
                    }
                }
            }
        }
    }

    // ── Add / edit sheet ─────────────────────────────────────────────────
    if root.form-open: FormSheet {
        width: root.width;
        height: root.height;

        heading: root.form-heading;
        name <=> root.form-name;
        serial <=> root.form-serial;
        link <=> root.form-link;
        purchase-date <=> root.form-purchase-date;
        warranty-start <=> root.form-warranty-start;
        warranty-end <=> root.form-warranty-end;
        name-error: root.form-name-error;
        purchase-date-error: root.form-purchase-date-error;
        warranty-start-error: root.form-warranty-start-error;
        warranty-end-error: root.form-warranty-end-error;
        notice: root.form-notice;
        docs: root.form-docs;
        busy: root.form-busy;

        add-pdf => {
            root.form-add-pdf();
        }
        remove-pdf(index) => {
            root.form-remove-pdf(index);
        }
        save => {
            root.form-save();
        }
        cancel => {
            root.form-cancel();
        }
        edited => {
            root.form-edited();
        }
    }

    // ── Theme picker (Chron5) ────────────────────────────────────────────
    //
    // Declared after the form sheet so it would draw over one if both were ever
    // up. They cannot be: a sheet's backdrop covers the whole window, so THEME
    // is unreachable while the form is open and the menu is unreachable while
    // the picker is.
    if root.theme-open: ThemeSheet {
        width: root.width;
        height: root.height;

        rows: root.theme-rows;

        theme-selected(index) => {
            root.theme-selected(index);
        }
        closed => {
            root.theme-open = false;
        }
    }
}
