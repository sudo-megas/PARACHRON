// Parachron — main window (CORE §4).
//
// Three fixed columns at 25 / 50 / 25, minimum 1000×700. Column 1 holds the
// sort chips, the search bar and the product list, with the About strip pinned
// to its foot; column 2 is the document viewer; column 3 is the details panel.
// About opens over columns 2 and 3 and leaves column 1 live.

import { ListView } from "std-widgets.slint";
import { Palette } from "palette.slint";
import { Strings } from "strings.slint";
import { Viewer, DocTab } from "viewer.slint";
import { FormSheet, FormDoc } from "form.slint";
import { ThemeSheet, ThemeItem } from "theme.slint";
import { Details } from "details.slint";
import { About, LicenseSheet } from "about.slint";
import { RelocateSheet } from "relocate.slint";
import { Btn, SearchBar } from "widgets.slint";

// Re-exported so Rust can reach the globals and the structs.
//
// `Palette` is here as of Chron5 and this is not cosmetic: `include_modules!`
// generates Rust bindings for exported globals only, so `app.global::<Palette>()`
// does not compile until the name is in this list. The whole of `theme.rs`
// depends on that one word.
export { Strings, Palette, DocTab, FormDoc, ThemeItem }

// One row of the product list. Assembled in Rust so that every string it
// carries — including the broken/warning prefixes — comes from the string table.
export struct ProductItem {
    label: string,
    name: string,
    detail: string,
    // The manifest could not be parsed at all.
    broken: bool,
    // The manifest parsed, but files it lists are not on disk.
    warning: bool,
}

// One of column 1's two sort toggles.
component SortChip inherits Rectangle {
    in property <string> label;
    /// What it does, for a screen reader — the chip itself is two letters.
    in property <string> description;
    in property <bool> active;
    callback clicked();

    height: 22px;
    width: chip-label.preferred-width + 18px;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.active ? Palette.accent : Palette.border;
    background: root.active ? Palette.selection : transparent;

    accessible-role: button;
    accessible-label: root.description;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => {
        root.clicked();
    }

    chip-label := Text {
        text: root.label;
        color: root.active ? Palette.text : Palette.muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One entry in the `Document ▾` menu.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    /// Set on the language row that is in effect (Chron6). Document actions leave
    /// it false — they are things to do, not states to be in.
    in property <bool> active: false;
    callback clicked();

    height: 30px;
    border-radius: 4px;
    background: root.active
        ? Palette.selection
        : (root.enabled && touch.has-hover ? Palette.raised : transparent);

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: root.active;
    accessible-checked: root.active;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.label;
            color: root.enabled ? Palette.text : Palette.muted;
            font-size: 13px;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        // The same tick the theme picker marks its active row with.
        Text {
            text: root.active ? Strings.check-glyph : "";
            color: Palette.accent;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    // Filled from Rust at startup.
    in property <[ProductItem]> products;

    // Selection state.
    //
    // `selected-index` is which *row* is highlighted, and -1 means none is. Since
    // Chron8 that is no longer the same question as whether a product is open:
    // the search bar can hide the selected product's row while the product stays
    // on screen, so -1 happens with a document still open. `selected-open` is the
    // question the viewer is gated on, and it has to be, because Chron3 recorded
    // that gating on the index makes a momentary -1 tear the viewer down and pay
    // the resize debounce to rebuild it.
    in-out property <int> selected-index: -1;
    in-out property <bool> selected-open: false;
    in-out property <string> selected-name;
    in-out property <string> selected-detail;
    in-out property <bool> selected-broken;

    // Viewer state, driven from Rust (Chron2).
    in property <[DocTab]> doc-tabs;
    in-out property <int> active-tab: 0;
    in property <image> page;
    in property <length> page-width;
    in property <length> page-height;
    in property <int> page-index;
    in property <int> page-count;
    in property <string> page-label;
    in property <bool> viewer-busy;
    in property <string> viewer-error;
    in property <string> selected-serial;
    in property <bool> serial-copied;
    in-out property <float> zoom: 1.0;

    // One product row. Shared so the scroll arithmetic below and the rows
    // themselves cannot drift apart.
    property <length> row-height: 38px;

    // Bring a row into view after the list has been rebuilt.
    //
    // Imperative, never a `viewport-y:` binding: the repeater *assigns*
    // `viewport-y` while laying out (including a zeroing pass when the model is
    // empty, which every window hits before Rust has filled it), and assigning
    // to a property removes its binding for good.
    //
    // Top-aligning rather than scrolling the minimum distance is also
    // deliberate. A jump of more than one and a half screens is snapped to a
    // whole row, and `idx * row-height` already sits on one — so this lands
    // exactly where it says it will, first time. A bottom-aligned target does
    // not, and would need calling twice.
    //
    // A negative index clamps to the top, which is also what a list that just
    // got shorter needs: the runtime does not clamp `viewport-y` against the
    // new, smaller `viewport-height`, and a stale offset leaves the list
    // showing its last row alone above a band of empty space.
    public function scroll-row-into-view(idx: int) {
        let limit = max(0px, list.viewport-height - list.visible-height);
        // Clamping what is already there is what rescues a list that just got
        // shorter: the runtime does not clamp `viewport-y` against the new,
        // smaller `viewport-height`, and a stale offset leaves the list showing
        // its last row alone above a band of empty space.
        let seen = clamp(-list.viewport-y, 0px, limit);

        if (idx < 0) {
            list.viewport-y = -seen;
            return;
        }

        let top = idx * root.row-height;
        let bottom = top + root.row-height;

        // Already in view: leave the list exactly where the user left it.
        // Scrolling on every click would drag the clicked row to the top and
        // throw away the scroll position they had chosen.
        if (top >= seen && bottom <= seen + list.visible-height) {
            list.viewport-y = -seen;
            return;
        }

        // Bringing a row down from above, or a jump far enough that the runtime
        // would snap a bottom-aligned target to a whole row and leave the row
        // half shown, is done by top-aligning — `idx * row-height` already sits
        // on a row boundary, so it lands exactly. Anything closer scrolls the
        // shortest distance instead.
        let far = top > seen + 2 * list.visible-height;
        let target = (top < seen || far) ? top : bottom - list.visible-height;
        list.viewport-y = -clamp(target, 0px, limit);
    }

    // ── Add and edit (Chron3) ────────────────────────────────────────────
    //
    // The sheet's text fields are `in-out`: the user types into them and Rust
    // reads them back when Save is pressed. Everything else is pushed from
    // Rust, already composed — the `.slint` side works out no messages of its
    // own.
    in property <bool> form-open;
    in property <string> form-heading;
    in-out property <string> form-name;
    in-out property <string> form-serial;
    in-out property <string> form-link;
    in-out property <string> form-purchase-date;
    in-out property <string> form-warranty-start;
    in-out property <string> form-warranty-end;
    in property <string> form-name-error;
    in property <string> form-purchase-date-error;
    in property <string> form-warranty-start-error;
    in property <string> form-warranty-end-error;
    in property <string> form-notice;
    in property <[FormDoc]> form-docs;
    in property <bool> form-busy;

    // ── Details column (Chron4) ──────────────────────────────────────────
    in property <bool> details-filled;
    in property <string> details-link;
    in property <string> details-purchase-date;
    in property <string> details-warranty-start;
    in property <string> details-warranty-end;
    /// Already formatted, expired case included — the string table holds no
    /// interpolation, so Rust composes it.
    in property <string> details-days-left;
    in property <bool> details-expired;
    in property <bool> link-copied;

    // ── Export (Chron7) ──────────────────────────────────────────────────
    in property <string> export-status;
    in property <bool> export-failed;
    /// An export is in flight. Lives on the window rather than only in Rust
    /// because `details::show` has to consult it — see `export::clear_status`.
    in property <bool> export-running;
    callback export();
    /// Rung from the export thread once it has finished. Carries nothing: the
    /// outcome waits in a slot, because the export cannot cross a thread boundary.
    callback export-finished();

    // ── Vault location (Chron9) ──────────────────────────────────────────
    //
    // CORE §3: the vault is wherever its owner put it. `Document ▾` opens a
    // folder picker, and what comes back is confirmed on a sheet before a single
    // file is copied — the sheet is where "5 documents, 24 MB" is said, which is
    // what makes confirming a decision rather than a dare.
    callback choose-vault();
    /// False when the vault could not be resolved at startup at all — no home
    /// directory, an unreadable `config.toml`, or a configured vault that is not
    /// there. Moving needs a source, and there is nothing to move from.
    in property <bool> relocate-available;
    in property <bool> relocate-open;
    /// The vault as it is now, and where it is going. Paths as they are on disk:
    /// CORE §4 says what is on disk is not UI copy and never translates.
    in property <string> relocate-from;
    in property <string> relocate-to;
    /// "5 documents · 24.1 MB", composed in Rust because the string table holds
    /// no interpolation.
    in property <string> relocate-summary;
    callback relocate-confirm();
    callback relocate-cancel();

    /// A move is in flight. While it is, the sheet cannot be dismissed and the
    /// confirm button is gone — there is no half of this that is safe to abandon.
    in property <bool> relocate-running;
    /// 0.0–1.0 by bytes, not by file count: five files of wildly different sizes
    /// make a per-file fraction jump about and then sit still.
    in property <float> relocate-fraction;
    /// "3 of 5 documents", and the file being copied, both composed in Rust.
    in property <string> relocate-progress;
    in property <string> relocate-current;
    /// A refusal or a failure. The sheet stays open holding it, rather than
    /// closing and leaving a notice that is gone when the app closes.
    in property <string> relocate-status;
    in property <bool> relocate-failed;
    /// The move landed. The sheet stays up saying so rather than vanishing.
    in property <bool> relocate-done;
    /// Rung per file from the move thread, and once more when it lands. Both
    /// carry nothing; the progress and the outcome wait in a shared slot,
    /// because neither can cross a thread boundary.
    callback relocate-progressed();
    callback relocate-finished();

    /// 0 as added, 1 alphabetical, 2 purchase date. CORE §4 describes two
    /// toggles over a default, which is what this is: clicking the active chip
    /// clears it back to 0.
    in property <int> sort-mode;

    // ── Theming (Chron5) ─────────────────────────────────────────────────
    //
    // The rows carry their own labels and their own active flag, both filled by
    // `theme.rs`, so nothing on this side knows how many themes there are.
    in property <[ThemeItem]> theme-rows;

    // ── Localization (Chron6) ────────────────────────────────────────────
    //
    // CORE §4 puts the language switch in `Document ▾`, and there are exactly
    // two, so they are two rows rather than a model. 0 is English, 1 Turkish.
    in property <int> lang-mode;
    callback language-selected(int);

    // ── Search (Chron8) ──────────────────────────────────────────────────
    //
    // `in-out` because the user types into it and the clear affordance writes it
    // back to empty. What the user typed is their data, not UI copy: it never
    // translates and it is never persisted.
    in-out property <string> search-query;
    callback search-changed(string);

    // ── About (Chron8) ───────────────────────────────────────────────────
    //
    // Values, not labels. The labels live in the `Strings` global and follow a
    // language switch; these four come from `Cargo.toml`, `build.rs` and the
    // bundled `LICENSE`, and are language-independent — which is exactly why the
    // About pane needs no refresh path even though column 1 stays live behind it.
    in property <string> app-version;
    in property <string> app-released;
    in property <string> app-license-id;
    in property <string> app-license-text;
    /// Where the vault is (Chron9). Unlike the four above this one *can* change
    /// while the window is open — a move rewrites it — so `relocate` pushes it
    /// again rather than it being filled once and forgotten.
    in property <string> app-vault-path;
    in property <bool> about-source-copied;
    in property <bool> about-docs-copied;
    in property <bool> about-vault-copied;
    callback about-copy-source();
    callback about-copy-docs();
    callback about-copy-vault();

    // Menu state is nobody's business but this file's, and so is whether the
    // theme picker is up: opening it is a UI gesture, and the only thing Rust
    // needs to hear about is a row being chosen. About and its licence sheet are
    // the same kind of thing — Rust fills them once and never needs to know
    // whether they are on screen.
    property <bool> menu-open: false;
    property <bool> theme-open: false;
    property <bool> about-open: false;
    property <bool> license-open: false;

    callback theme-selected(int);
    callback product-selected(int);
    callback tab-selected(int);
    callback page-requested(int);
    callback zoom-changed(float);
    callback copy-serial();
    callback copy-link();
    callback sort-toggled(int);
    callback viewport-resized(length, length);

    callback add-document();
    callback edit-document();
    callback form-add-pdf();
    callback form-remove-pdf(int);
    callback form-save();
    callback form-cancel();
    callback form-edited();
    /// Rung from the commit thread once a save has landed. It carries nothing:
    /// the outcome waits in a slot the editor reads, because the editor cannot
    /// cross a thread boundary.
    callback form-commit-finished();

    title: Strings.app-title;
    icon: @image-url("../build/icons/parachron-256.png");
    background: Palette.bg;

    // CORE §4: the window never shrinks below this.
    min-width: 1000px;
    min-height: 700px;
    preferred-width: 1280px;
    preferred-height: 800px;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        // ── Title bar ────────────────────────────────────────────────────
        Rectangle {
            height: 48px;
            background: Palette.panel;

            // Bottom hairline.
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Palette.border;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                Image {
                    source: @image-url("../build/icons/parachron-64.png");
                    width: 26px;
                    height: 26px;
                    image-fit: contain;
                    y: (parent.height - self.height) / 2;
                }

                menu-button := Btn {
                    label: Strings.menu-document;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.menu-open = !root.menu-open;
                    }
                }

                add-button := Btn {
                    label: Strings.action-add-document;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.menu-open = false;
                        root.add-document();
                    }
                }

                // Pushes the wordmark to the centre of the remaining space.
                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: Strings.app-title;
                    color: Palette.text;
                    font-size: 16px;
                    font-weight: 700;
                    letter-spacing: 3px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ── Body: three fixed columns, 25 / 50 / 25 ──────────────────────
        //
        // Positioned explicitly rather than by layout stretch so the ratio is
        // exact at every window size (CORE §4). Column 3 takes the remainder,
        // so rounding can never leave a seam.
        body := Rectangle {
            vertical-stretch: 1;

            // Column 1 — product list.
            col1 := Rectangle {
                x: 0;
                y: 0;
                width: body.width / 4;
                height: body.height;
                background: Palette.panel;
                clip: true;

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;

                    // ── Sort toggles (CORE §4) ───────────────────────────
                    //
                    // Two chips over a default of insertion order, which is
                    // literally what CORE §4 asks for: clicking the active one
                    // again clears it rather than needing a third chip.
                    Rectangle {
                        height: 34px;
                        background: Palette.panel;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;

                            sort-name := SortChip {
                                y: (parent.height - self.height) / 2;
                                label: Strings.sort-name;
                                description: Strings.sort-by-name;
                                active: root.sort-mode == 1;
                                clicked => {
                                    root.sort-toggled(root.sort-mode == 1 ? 0 : 1);
                                }
                            }

                            sort-purchase := SortChip {
                                y: (parent.height - self.height) / 2;
                                label: Strings.sort-purchase;
                                description: Strings.sort-by-purchase;
                                active: root.sort-mode == 2;
                                clicked => {
                                    root.sort-toggled(root.sort-mode == 2 ? 0 : 2);
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }
                        }

                        // Bottom hairline.
                        Rectangle {
                            x: 0;
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Palette.border;
                        }
                    }

                    // ── Search (CORE §4) ─────────────────────────────
                    //
                    // Directly above the entries, under the sort chips. The
                    // query goes straight to Rust on every keystroke; the vault
                    // filters and rebuilds the rows without telling the viewer,
                    // so typing never disturbs the open document.
                    search := SearchBar {
                        text <=> root.search-query;
                        edited(query) => {
                            root.search-changed(query);
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;

                        list := ListView {
                            width: parent.width;
                            height: parent.height;

                            for item[idx] in root.products: Rectangle {
                                height: root.row-height;
                                background: idx == root.selected-index ? Palette.selection : transparent;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: item.label;
                                        color: item.broken
                                            ? Palette.danger
                                            : item.warning ? Palette.accent : Palette.text;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                row-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.selected-index = idx;
                                        root.selected-open = true;
                                        root.selected-name = item.name;
                                        root.selected-detail = item.detail;
                                        root.selected-broken = item.broken;
                                        // Choosing a product is choosing to look
                                        // at it, so About steps out of the way.
                                        // Otherwise the click lands, the
                                        // selection changes, and nothing visible
                                        // happens — a list that looks broken.
                                        root.about-open = false;
                                        root.product-selected(idx);
                                    }
                                }
                            }
                        }

                        // Two empty lists, two different sentences. An empty
                        // vault means "there is nothing here yet"; an empty
                        // result means "nothing matched what you typed". Sharing
                        // one string would tell somebody their vault was empty
                        // because they mistyped four characters, which for an app
                        // whose promise is keeping their documents is the most
                        // alarming thing it could say.
                        if root.products.length == 0: Text {
                            x: 14px;
                            y: 18px;
                            width: parent.width - 28px;
                            text: root.search-query == ""
                                ? Strings.list-empty
                                : Strings.search-no-matches;
                            color: Palette.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    // Fixed About strip (CORE §4), live since Chron8. It toggles:
                    // the strip is both the way in and one of the ways out, so
                    // there is never a pane on screen with no visible way back.
                    about-strip := Rectangle {
                        height: 42px;
                        background: root.about-open
                            ? Palette.selection
                            : (about-touch.has-hover ? Palette.raised : Palette.panel);

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: 1px;
                            background: Palette.border;
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;

                            Text {
                                text: Strings.about-glyph;
                                color: root.about-open ? Palette.text : Palette.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Strings.nav-about;
                                color: root.about-open ? Palette.text : Palette.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }

                        about-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.about-open = !root.about-open;
                            }
                        }

                        accessible-role: button;
                        accessible-label: Strings.nav-about;
                        accessible-checkable: true;
                        accessible-checked: root.about-open;
                        accessible-action-default => {
                            root.about-open = !root.about-open;
                        }
                    }
                }
            }

            // Column 2 — document viewer (Chron2).
            col2 := Rectangle {
                x: col1.width;
                y: 0;
                width: body.width / 2;
                height: body.height;
                background: Palette.bg;
                clip: true;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Palette.border;
                }

                // Nothing selected, or a folder that would not parse — the
                // viewer has nothing to open, so Chron1's reason display stays.
                if !root.selected-open || root.selected-broken: VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: root.selected-open ? root.selected-name : Strings.select-prompt;
                        color: root.selected-broken ? Palette.danger : Palette.text;
                        font-size: 20px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.selected-detail;
                        color: Palette.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                if root.selected-open && !root.selected-broken: viewer := Viewer {
                    x: 1px;
                    width: parent.width - 1px;
                    height: parent.height;

                    tabs: root.doc-tabs;
                    active-tab: root.active-tab;
                    page: root.page;
                    page-width: root.page-width;
                    page-height: root.page-height;
                    page-index: root.page-index;
                    page-count: root.page-count;
                    page-label: root.page-label;
                    busy: root.viewer-busy;
                    error-text: root.viewer-error;
                    serial: root.selected-serial;
                    serial-copied: root.serial-copied;
                    zoom: root.zoom;

                    tab-selected(index) => {
                        root.tab-selected(index);
                    }
                    page-requested(page) => {
                        root.page-requested(page);
                    }
                    zoom-changed(value) => {
                        root.zoom-changed(value);
                    }
                    copy-serial => {
                        root.copy-serial();
                    }
                    viewport-resized(w, h) => {
                        root.viewport-resized(w, h);
                    }
                }
            }

            // Column 3 — details and actions (Chron4). Takes the remainder so
            // the three widths always sum to exactly the window width.
            col3 := Rectangle {
                x: col1.width + col2.width;
                y: 0;
                width: body.width - col1.width - col2.width;
                height: body.height;
                background: Palette.panel;
                clip: true;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Palette.border;
                }

                details := Details {
                    x: 1px;
                    width: parent.width - 1px;
                    height: parent.height;

                    filled: root.details-filled;
                    link: root.details-link;
                    purchase-date: root.details-purchase-date;
                    warranty-start: root.details-warranty-start;
                    warranty-end: root.details-warranty-end;
                    days-left: root.details-days-left;
                    expired: root.details-expired;
                    link-copied: root.link-copied;
                    export-status: root.export-status;
                    export-failed: root.export-failed;

                    copy-link => {
                        root.copy-link();
                    }
                    open-theme => {
                        root.menu-open = false;
                        root.theme-open = true;
                    }
                    export => {
                        root.export();
                    }
                }
            }

            // ── About (CORE §4) ──────────────────────────────────────────
            //
            // Covers columns 2 and 3 exactly, declared after them so it draws
            // over them. Column 1 stays live underneath, which is what CORE §4
            // asks for: About replaces the *content*, not the app.
            //
            // Covering rather than replacing is deliberate, and it is the reason
            // this is four lines instead of a restructure. Column 3's width is
            // the remainder of what columns 1 and 2 left, so rounding can never
            // open a seam — which means `col3` references `col2` by id, and an
            // element inside an `if` cannot be referenced by id from a sibling.
            // Wrapping both columns in one conditional would work and would cost
            // a level of nesting through two hundred lines; not putting them in a
            // conditional at all costs nothing and keeps every id exactly where
            // `assert_columns` looks for it.
            //
            // It also means the viewer is never torn down by opening About, so
            // coming back is instant rather than paying the resize debounce to
            // rebuild a document that was already open — the same cost Chron3
            // recorded for a `selected-index` that passes through -1.
            if root.about-open: About {
                x: col1.width;
                y: 0;
                width: body.width - col1.width;
                height: body.height;

                version: root.app-version;
                released: root.app-released;
                license-id: root.app-license-id;
                vault-path: root.app-vault-path;
                source-copied: root.about-source-copied;
                docs-copied: root.about-docs-copied;
                vault-copied: root.about-vault-copied;

                copy-vault => {
                    root.about-copy-vault();
                }
                copy-source => {
                    root.about-copy-source();
                }
                copy-docs => {
                    root.about-copy-docs();
                }
                read-license => {
                    root.license-open = true;
                }
                dismissed => {
                    root.about-open = false;
                }
            }
        }
    }

    // ── Document ▾ menu ──────────────────────────────────────────────────
    //
    // Hand-rolled rather than a `PopupWindow`. Elements inside a popup are not
    // reliably realised for the testing backend's element lookup, which would
    // put the whole menu — and the only route to the edit form — outside the
    // headless tests. This is a comparable amount of code and stays reachable.
    //
    // Declared after the layout so it draws over it, with a transparent layer
    // behind it to catch the dismissing click.
    if root.menu-open: Rectangle {
        dismiss-menu := TouchArea {
            clicked => {
                root.menu-open = false;
            }
        }

        Rectangle {
            x: 14px;
            y: 44px;
            width: 190px;
            height: menu-items.preferred-height;
            background: Palette.panel;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.border;

            menu-items := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                menu-add := MenuRow {
                    label: Strings.action-add-document;
                    clicked => {
                        root.menu-open = false;
                        root.add-document();
                    }
                }

                menu-edit := MenuRow {
                    label: Strings.action-edit-document;
                    // A folder whose manifest will not parse is repaired in a
                    // text editor, not guessed at by a form.
                    enabled: root.selected-open && !root.selected-broken;
                    clicked => {
                        root.menu-open = false;
                        root.edit-document();
                    }
                }

                // ── Vault location (Chron9) ──────────────────────────────
                //
                // Below the two document actions and above the language rows: it
                // is a thing done to the vault rather than to a document, and it
                // is done once rather than daily.
                Rectangle {
                    height: 7px;
                    Rectangle {
                        x: 4px;
                        y: 3px;
                        width: parent.width - 8px;
                        height: 1px;
                        background: Palette.border;
                    }
                }

                menu-vault := MenuRow {
                    label: Strings.action-vault-location;
                    // A move already running is the one state where opening the
                    // picker again would start a second one over the same files.
                    enabled: root.relocate-available && !root.relocate-running;
                    clicked => {
                        root.menu-open = false;
                        root.choose-vault();
                    }
                }

                // ── Language (CORE §4) ───────────────────────────────────
                //
                // A hairline and a heading, so the two language rows do not read
                // as two more document actions.
                Rectangle {
                    height: 7px;
                    Rectangle {
                        x: 4px;
                        y: 3px;
                        width: parent.width - 8px;
                        height: 1px;
                        background: Palette.border;
                    }
                }

                Text {
                    text: Strings.menu-language;
                    color: Palette.muted;
                    font-size: 11px;
                    letter-spacing: 1px;
                    height: 18px;
                    vertical-alignment: center;
                    x: 10px;
                }

                menu-lang-en := MenuRow {
                    label: Strings.lang-english;
                    active: root.lang-mode == 0;
                    clicked => {
                        root.menu-open = false;
                        root.language-selected(0);
                    }
                }

                menu-lang-tr := MenuRow {
                    label: Strings.lang-turkish;
                    active: root.lang-mode == 1;
                    clicked => {
                        root.menu-open = false;
                        root.language-selected(1);
                    }
                }
            }
        }
    }

    // ── Add / edit sheet ─────────────────────────────────────────────────
    if root.form-open: FormSheet {
        width: root.width;
        height: root.height;

        heading: root.form-heading;
        name <=> root.form-name;
        serial <=> root.form-serial;
        link <=> root.form-link;
        purchase-date <=> root.form-purchase-date;
        warranty-start <=> root.form-warranty-start;
        warranty-end <=> root.form-warranty-end;
        name-error: root.form-name-error;
        purchase-date-error: root.form-purchase-date-error;
        warranty-start-error: root.form-warranty-start-error;
        warranty-end-error: root.form-warranty-end-error;
        notice: root.form-notice;
        docs: root.form-docs;
        busy: root.form-busy;

        add-pdf => {
            root.form-add-pdf();
        }
        remove-pdf(index) => {
            root.form-remove-pdf(index);
        }
        save => {
            root.form-save();
        }
        cancel => {
            root.form-cancel();
        }
        edited => {
            root.form-edited();
        }
    }

    // ── Theme picker (Chron5) ────────────────────────────────────────────
    //
    // Declared after the form sheet so it would draw over one if both were ever
    // up. They cannot be: a sheet's backdrop covers the whole window, so THEME
    // is unreachable while the form is open and the menu is unreachable while
    // the picker is.
    if root.theme-open: ThemeSheet {
        width: root.width;
        height: root.height;

        rows: root.theme-rows;

        theme-selected(index) => {
            root.theme-selected(index);
        }
        closed => {
            root.theme-open = false;
        }
    }

    // The bundled licence (CORE §4). A sheet rather than part of the About pane
    // because it is the one thing here that has to scroll — 34KB of legal text
    // in a pane sized for eleven short rows would be neither.
    //
    // Declared last so it draws over everything, About included: it is opened
    // from the pane and returns to it.
    if root.license-open: LicenseSheet {
        width: root.width;
        height: root.height;

        text: root.app-license-text;

        closed => {
            root.license-open = false;
        }
    }

    // Moving the vault (Chron9). Declared after the licence sheet so that a move
    // started from the menu draws over anything else that happens to be open —
    // it is the only sheet in the app that is holding the user's documents.
    if root.relocate-open: RelocateSheet {
        width: root.width;
        height: root.height;

        from-path: root.relocate-from;
        to-path: root.relocate-to;
        summary: root.relocate-summary;
        running: root.relocate-running;
        fraction: root.relocate-fraction;
        progress: root.relocate-progress;
        current: root.relocate-current;
        status: root.relocate-status;
        failed: root.relocate-failed;
        done: root.relocate-done;

        confirm => {
            root.relocate-confirm();
        }
        cancel => {
            root.relocate-cancel();
        }
        // Escape is Cancel, and while a move runs it is neither: `relocate-cancel`
        // ignores the call rather than this scope having to know why.
        dismissed => {
            root.relocate-cancel();
        }
    }
}
