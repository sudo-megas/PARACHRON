// The add/edit sheet.
//
// An overlay inside the window rather than a second window: nothing to get
// lost behind the main window, no second lifecycle to manage, Chron5 themes it
// for free, and the headless harness can reach it like anything else.
//
// The backdrop-and-card recipe moved to `sheet.slint` in Chron5, when the theme
// picker became the second sheet. What was a `#000000.with-alpha(0.55)` literal
// here is now `Palette.backdrop`, which is the whole point: it was the one colour
// in `ui/` outside the palette, and exactly the one that would have dimmed a
// light theme with a dark theme's black.
//
// This component holds no text of its own. Labels come through the `Strings`
// global; the heading and every message arrive as properties, already composed
// by Rust, the same way the viewer's error text does.

import { Palette } from "palette.slint";
import { Strings } from "strings.slint";
import { Btn, GlyphBtn, Field } from "widgets.slint";
import { Sheet } from "sheet.slint";

/// One document attached to the product being edited.
export struct FormDoc {
    /// File name as it will be written into the product folder.
    label: string,
    /// Page count, or why the file was refused. Pre-formatted in Rust.
    detail: string,
    failed: bool,
}

export component FormSheet inherits Sheet {
    in property <string> heading;

    in-out property <string> name;
    in-out property <string> serial;
    in-out property <string> link;
    in-out property <string> purchase-date;
    in-out property <string> warranty-start;
    in-out property <string> warranty-end;

    // Empty when the field is fine.
    in property <string> name-error;
    in property <string> purchase-date-error;
    in property <string> warranty-start-error;
    in property <string> warranty-end-error;
    /// Anything that is not about one field — a write that failed, say.
    in property <string> notice;

    in property <[FormDoc]> docs;
    /// A file is being checked or copied; the sheet stays up but stops taking
    /// a second Save.
    in property <bool> busy;

    callback add-pdf();
    callback remove-pdf(int);
    callback save();
    callback cancel();
    callback edited();

    // Escape cancels the edit. The backdrop deliberately does not — see
    // `sheet.slint` for why a half-filled form is not thrown away by a stray
    // click.
    dismissed => {
        root.cancel();
    }

    Text {
        text: root.heading;
        color: Palette.text;
        font-size: 18px;
        font-weight: 700;
    }

    Field {
        label: Strings.field-name;
        text <=> root.name;
        error: root.name-error;
        edited => { root.edited(); }
        accepted => { root.save(); }
    }

    Field {
        label: Strings.serial-label;
        text <=> root.serial;
        edited => { root.edited(); }
        accepted => { root.save(); }
    }

    Field {
        label: Strings.field-link;
        text <=> root.link;
        edited => { root.edited(); }
        accepted => { root.save(); }
    }

    HorizontalLayout {
        spacing: 12px;

        Field {
            label: Strings.field-purchase-date;
            hint: Strings.date-hint;
            text <=> root.purchase-date;
            error: root.purchase-date-error;
            edited => { root.edited(); }
            accepted => { root.save(); }
        }

        Field {
            label: Strings.field-warranty-start;
            hint: Strings.date-hint;
            text <=> root.warranty-start;
            error: root.warranty-start-error;
            edited => { root.edited(); }
            accepted => { root.save(); }
        }

        Field {
            label: Strings.field-warranty-end;
            hint: Strings.date-hint;
            text <=> root.warranty-end;
            error: root.warranty-end-error;
            edited => { root.edited(); }
            accepted => { root.save(); }
        }
    }

    // ── Documents ────────────────────────────────────────────────
    Text {
        text: Strings.field-documents;
        color: Palette.muted;
        font-size: 12px;
        letter-spacing: 1px;
    }

    if root.docs.length == 0: Text {
        text: Strings.no-documents-yet;
        color: Palette.muted;
        font-size: 13px;
    }

    for doc[idx] in root.docs: Rectangle {
        height: 30px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: doc.label;
                color: doc.failed ? Palette.danger : Palette.text;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: doc.detail;
                color: doc.failed ? Palette.danger : Palette.muted;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            remove-doc := GlyphBtn {
                glyph: Strings.remove-glyph;
                accessible-label: Strings.remove-glyph;
                clicked => {
                    root.remove-pdf(idx);
                }
            }
        }
    }

    HorizontalLayout {
        add-pdf := Btn {
            label: Strings.action-add-pdf;
            enabled: !root.busy;
            clicked => {
                root.add-pdf();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }

    if root.busy || root.notice != "": Text {
        text: root.busy ? Strings.checking : root.notice;
        color: root.busy ? Palette.muted : Palette.danger;
        font-size: 13px;
        wrap: word-wrap;
    }

    Rectangle {
        vertical-stretch: 1;
    }

    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
        }
        cancel := Btn {
            label: Strings.action-cancel;
            clicked => {
                root.cancel();
            }
        }
        save := Btn {
            label: Strings.action-save;
            primary: true;
            enabled: !root.busy;
            clicked => {
                root.save();
            }
        }
    }
}
