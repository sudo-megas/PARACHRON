// The UI half of the string table.
//
// CORE §4: no hardcoded strings in `.slint` or Rust — every user-visible piece
// of text is a property here, filled from `src/strings.rs` at startup and
// refilled whenever the language changes (Chron6). One property per
// `strings::Key`.

export global Strings {
    // Identity and chrome
    in property <string> app-title;
    in property <string> menu-document;
    in property <string> action-add-document;
    in property <string> action-theme;
    in property <string> action-export;
    in property <string> nav-about;

    // Product list
    in property <string> list-empty;

    // Shown in place of a column that has nothing to say yet
    in property <string> select-prompt;
    in property <string> details-placeholder;

    // Document viewer
    in property <string> no-documents;
    in property <string> rendering;
    in property <string> prev-page;
    in property <string> next-page;
    in property <string> zoom-label;
    in property <string> serial-label;
    in property <string> copied;
    in property <string> prev-glyph;
    in property <string> next-glyph;
    in property <string> copy-glyph;

    // Add and edit (Chron3). The form's heading and its per-field messages are
    // not here: they depend on which mode the form is in and on what the user
    // typed, so Rust composes them and pushes them as ordinary properties —
    // the same rule the viewer's error text follows.
    in property <string> action-edit-document;
    in property <string> field-name;
    in property <string> field-link;
    in property <string> field-purchase-date;
    in property <string> field-warranty-start;
    in property <string> field-warranty-end;
    in property <string> field-documents;
    in property <string> date-hint;
    in property <string> action-add-pdf;
    in property <string> action-save;
    in property <string> action-cancel;
    in property <string> remove-glyph;
    in property <string> checking;
    in property <string> no-documents-yet;

    // Details column and sorting (Chron4). The countdown itself is not here:
    // its number, unit and expired case are composed in Rust.
    in property <string> warranty-left;
    in property <string> sort-name;
    in property <string> sort-purchase;
    in property <string> sort-by-name;
    in property <string> sort-by-purchase;

    // Theming (Chron5). The eleven theme names are not here: they arrive as
    // picker rows, already looked up, because Rust also has to say which one is
    // active and one model carrying both cannot disagree with itself.
    in property <string> theme-title;
    in property <string> action-close;
    in property <string> check-glyph;

    // Localization (Chron6). Both language names read the same in both tables —
    // a reader stranded in the wrong language has to recognise their own.
    in property <string> menu-language;
    in property <string> lang-english;
    in property <string> lang-turkish;

    // Search (Chron8). The query is user data and lives on the window, not here.
    in property <string> search-placeholder;
    in property <string> search-no-matches;
    in property <string> search-clear;

    // About (Chron8). Labels only. The version, the build date and the licence id
    // come from `Cargo.toml` and `build.rs` and arrive as window properties, and
    // the bundled licence text arrives the same way — none of the four is UI copy
    // and none of them translates.
    in property <string> about-glyph;
    in property <string> about-wordmark;
    in property <string> about-subtitle;
    in property <string> about-maker;
    in property <string> about-maker-name;
    in property <string> about-version;
    in property <string> about-released;
    in property <string> about-source;
    in property <string> about-source-url;
    in property <string> about-docs;
    in property <string> about-docs-url;
    in property <string> about-not-links;
    in property <string> about-license;
    in property <string> about-read-license;
    in property <string> about-motto;
}
