# Maintainer: sudo-megas <296978292+sudo-megas@users.noreply.github.com>
#
# Parachron — a desktop vault for purchases (Chron11).
#
# Build and install from a clone of the repository:
#
#     git clone https://github.com/sudo-megas/PARACHRON.git
#     cd PARACHRON/packaging
#     makepkg -si
#
# This PKGBUILD builds the working tree it sits in, rather than downloading a
# release tarball. That is a deliberate choice and it is the one the README
# depends on: the page tells a visitor to clone and run `makepkg -si`, and it
# has to work *today*, before the first tag exists. A `source=()` pointing at
# `v$pkgver.tar.gz` would be the more conventional shape and would fail on a
# repository whose Releases page is empty — which is exactly the state this one
# is in until a person pushes a tag.
#
# `pkgver` below is kept in step with `Cargo.toml` by a check in
# `.github/workflows/ci.yml`, so the two cannot drift into a package whose
# filename disagrees with the version its own About pane reports.

pkgname=parachron
pkgver=1.1.0
pkgrel=1
pkgdesc="A desktop vault for purchases: invoices, warranty documents, serial numbers and a warranty countdown, kept together"
arch=('x86_64')
url="https://github.com/sudo-megas/PARACHRON"
license=('AGPL-3.0-only')

# Two lists, and the second one is the reason this file has a comment block
# rather than a one-line `depends`.
#
# `ldd target/release/parachron` reports the first group: the libraries the
# binary links at load time. Building `depends` from that alone produces a
# package that installs cleanly, appears in the menu, and then produces nothing
# when it is clicked — because the toolkit and the file-dialog crate open the
# second group with `dlopen` at runtime, and a `dlopen`ed library appears in no
# `ldd` output at all.
#
# That is the worst shape a packaging bug can take: it passes every check a
# packager runs and fails on somebody else's machine, at the only moment that
# matters. The two lists are written out in full here and in
# `[package.metadata.deb]`, they are the same list, and they move together.
#
# Both were measured rather than recalled: `ldd` for the first, and the soname
# literals carried in the release binary itself for the second.
depends=(
  # ── Linked at load time — what `ldd` reports. ──
  'fontconfig'
  'freetype2'
  'libpng'
  'expat'
  'bzip2'
  'brotli'          # libbrotlidec.so.1, libbrotlicommon.so.1
  'zlib'
  'glibc'           # libc.so.6, libm.so.6, ld-linux
  'gcc-libs'        # libgcc_s.so.1

  # ── Opened at runtime with `dlopen`. Invisible to `ldd`. ──
  #
  # Slint's winit backend needs these to put a window on screen, under X11 and
  # under Wayland both. A package must carry both sets: which one is used is a
  # fact about the session the app is launched in, not about the build.
  'libx11'           # libX11.so.6, libX11-xcb.so.1
  'libxcb'           # libxcb.so.1
  'libxcursor'       # libXcursor.so.1
  'libxrender'       # libXrender.so.1
  'libxi'            # libXi.so.6
  'libxkbcommon'     # libxkbcommon.so.0
  'libxkbcommon-x11' # libxkbcommon-x11.so.0
  'wayland'          # libwayland-client.so.0, libwayland-egl.so.1
  'libglvnd'         # libEGL.so.1, libGL.so.1

  # The thirteenth, and the one worth its own paragraph.
  #
  # `rfd`'s xdg-desktop-portal backend opens libdbus itself, at
  # `rfd/src/backend/xdg_desktop_portal/portal/ffi.rs:199`:
  #
  #     Liblary::open(c"libdbus-1.so.3").or_else(|| Liblary::open(c"libdbus-1.so"))
  #
  # and when it is missing it does not panic — `portal/libdbus.rs:77` logs
  # "Can't connect to a portal: libdbus-1.so not found" and carries on. Every
  # other library above is needed to open a window, so omitting one produces an
  # app that does not start: loud, and caught by the first person to click the
  # launcher. This one is needed to open a *file dialog*, so omitting it
  # produces an app that starts, draws its window, opens its menu, and then does
  # nothing at all when `Add Document` or `EXPORT` is chosen. An app that cannot
  # add a document is not a working app.
  'dbus'             # libdbus-1.so.3

  # The fourteenth, and it is not a library at all.
  #
  # `fontconfig` above is the library that *finds* fonts. It is not a font. On a
  # system that has fontconfig and no font files, the lookup returns no match
  # and `fontique` unwraps it:
  #
  #   fontique/src/backend/fontconfig.rs:685
  #   called `Result::unwrap()` on an `Err` value: NoMatch
  #
  # which is a panic rather than a blank window. Found the only way it could be
  # found — by building this package in a bare `archlinux:base-devel` container,
  # where `check()` ran 187 tests and the one that instantiates a real window
  # was the single failure.
  #
  # `ttf-font` is the virtual package every font on Arch provides, so this asks
  # for "a font" rather than picking one on the user's behalf. Any desktop
  # already satisfies it; a minimal install or a container does not, and that is
  # exactly the machine this would otherwise panic on.
  'ttf-font'
)

makedepends=('cargo' 'clang')

# **`!lto`, and without it this package does not link at all.**
#
# Found by running this file rather than by reading it. Arch's stock
# `/etc/makepkg.conf` ships `OPTIONS=(… lto)` with `LTOFLAGS="-flto=auto"`, so
# makepkg appends GCC's link-time-optimisation flag to `CFLAGS`, `CXXFLAGS` and
# `LDFLAGS` for every package built on the machine. `mupdf-sys` vendors MuPDF's
# C source and compiles it with `cc`, which picks those flags up — so the static
# archive it produces holds **GCC LTO bytecode instead of native objects**.
#
# Rust then links with `rust-lld`, which cannot read GCC's LTO intermediate
# representation. It does not say so. It reports every single MuPDF symbol as
# undefined:
#
#     rust-lld: error: undefined symbol: fz_clone_context
#     rust-lld: error: undefined symbol: pdf_default_write_options
#     rust-lld: error: undefined symbol: mupdf_pdf_write_document
#
# which reads like a missing library and is actually an unreadable one. The
# build succeeds outside makepkg and fails inside it, on the same machine, from
# the same source — the only difference being the flags makepkg exports.
#
# This is Arch's default rather than this machine's preference, so it would have
# broken the `makepkg -si` route the README documents, *and* the `.pkg.tar.zst`
# release asset built in the archlinux container, on their first real run.
#
# `!lto` turns off LTO for the *C* half only. `[profile.release]` in
# `Cargo.toml` still applies Rust's own LTO across the Rust half, which is where
# Slint's generated code lives and where it was worth having.
#
# `!debug` because `[profile.release]` already sets `strip = true`: there are no
# debug symbols left for makepkg to split out, and asking it to build a
# `parachron-debug` package from a stripped binary produces an empty package and
# a `-g` flag nothing reads.
options=(!lto !debug)

# Nothing is downloaded. The build reads the checkout this file lives in; see
# the header for why.
source=()
sha256sums=()

prepare() {
  # Copy the checkout into makepkg's own `$srcdir` instead of building where it
  # sits. The first draft of this file built in place, and that is a bug rather
  # than a shortcut — it was found by running this file, which is the only way
  # it could have been found:
  #
  #   makepkg creates `pkg/` and `src/` inside `$startdir`, which here is
  #   `packaging/`, and it creates `pkg/` with mode 0111 — traversable but not
  #   readable. Cargo's build-script fingerprint step walks the entire crate
  #   directory looking for the most recently modified file, reaches
  #   `packaging/pkg`, and stops with a bare
  #
  #       Caused by: Permission denied (os error 13)
  #
  #   naming a directory the packager never created and cannot read. The build
  #   fails before a single crate is compiled, and nothing in the message
  #   suggests that the packaging directory is inside the thing being packaged.
  #
  # Copying out also means a `makepkg` run does not leave a release profile in
  # the user's own `target/`, which is ordinary hygiene rather than a fix.
  #
  # The exclusions are what makes this cheap: `target/` is the build output and
  # `.git` is the history, and copying either would move gigabytes to build
  # megabytes.
  rm -rf "${srcdir:?}/${pkgname}"
  mkdir -p "$srcdir/$pkgname"
  tar -c -C "$startdir/.." \
      --exclude=./target \
      --exclude=./.git \
      --exclude=./packaging/pkg \
      --exclude=./packaging/src \
      . | tar -x -C "$srcdir/$pkgname"
}

build() {
  cd "$srcdir/$pkgname"

  # Arch packaging convention: pin the toolchain rather than inheriting whatever
  # a user's environment points at.
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/$pkgname/target"

  # `--locked` builds exactly what `Cargo.lock` records. A package built from a
  # silently-updated dependency graph is not the package that was tested.
  #
  # This compiles the vendored MuPDF from C source every time, because `$srcdir`
  # starts empty. That is the cost of building from a pristine tree rather than
  # from whatever happens to be cached, and for a package it is the right way
  # round.
  cargo build --release --locked
}

check() {
  cd "$srcdir/$pkgname"

  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/$pkgname/target"

  # Dev profile, deliberately, and `--release` here would be a mistake rather
  # than an optimisation. `build.rs` emits Slint's debug info only when Cargo
  # sets `DEBUG=true`, and Slint records the element ids that every headless
  # assertion in `src/ui_tests.rs` looks up only when debug info is present. A
  # release-profile test run does not run a faster suite; it runs one where
  # every element lookup finds nothing.
  cargo test --locked
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"

  # CORE §7's install layout. 1024 is deliberately absent: it is 1.6MB on its
  # own, larger than any icon theme will ever ask for, and exists as artwork for
  # a README header rather than as an icon. It stays in the repository and ships
  # in nothing.
  local size
  for size in 16 24 32 48 64 96 128 256 512; do
    install -Dm644 "build/icons/${pkgname}-${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${pkgname}.png"
  done

  install -Dm644 "packaging/org.parachron.Parachron.desktop" \
    "${pkgdir}/usr/share/applications/org.parachron.Parachron.desktop"

  # Arch's own policy path, which is not the path Debian uses for the same file
  # — `[package.metadata.deb]` installs it to /usr/share/doc/parachron/copyright
  # instead. Each distribution's tooling reads its own, and AGPL-3.0 requires the
  # text to actually be there (CORE §1).
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
